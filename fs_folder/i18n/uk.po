#. module: fs_folder
#. odoo-python
#: code:addons/fs_folder/models/fs_storage.py:0
msgid ""
"No default storage found for the content of the external filesystem fields "
"for model %(model)s and field %(field)s. Please set a default storage in the"
" filesystem storage configuration."
msgstr ""
"Не знайдено сховища за замовчуванням для вмісту полів зовнішньої файлової "
"системи моделі %(model)s і поля %(field)s. Установіть сховище за "
"замовчуванням у налаштуваннях сховища файлової системи."

#. module: fs_folder
#. odoo-python
#: code:addons/fs_folder/models/fs_storage.py:0
msgid "Only one storage can be used as default for filesystem contents."
msgstr ""
"Лише одне сховище можна використовувати як типове для вмісту файлової "
"системи."

#. module: fs_folder
#. odoo-python
#: code:addons/fs_folder/upgrades/18.0.2.0.1/post-migration.py:0
msgid ""
"The 'fs_folder_environment' module is not available. It is required to "
"preserve the server environment managed fields of 'fs.storage'. Make it "
"available on the addons path before upgrading 'fs_folder'."
msgstr ""
"Модуль 'fs_folder_environment' недоступний. Він потрібен для збереження "
"полів 'fs.storage', керованих середовищем сервера. Зробіть його доступним у "
"шляху addons перед оновленням 'fs_folder'."

#. module: fs_folder
#. odoo-python
#: code:addons/fs_folder/models/fs_storage.py:0
msgid "The character to use as replacement can not be one of '%s'"
msgstr "Символ для заміни не може бути одним із «%s»"

#. module: fs_folder
#. odoo-python
